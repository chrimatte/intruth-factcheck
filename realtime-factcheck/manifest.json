{
  "manifest_version": 3,
  "name": "InTruth",
  "version": "2.0.4",
  "minimum_chrome_version": "116",
  "description": "Evidence-first, real-time claim verification for supported video pages",

  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "offscreen"
  ],

  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://google.serper.dev/*",
    "https://api.deepgram.com/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker-ex.js"
  },

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.jubileemedia.com/*",
        "https://*.jubilee.com/*"
      ],
      "js": [
        "src/content/lexical-features.js",
        "src/content/session-export.js",
        "src/content/overlay.js"
      ]
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["src/content/overlay.css"],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.jubileemedia.com/*",
        "https://*.jubilee.com/*"
      ]
    }
  ],

  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
